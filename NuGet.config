<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained NuGet source configuration.

  Why this file exists: the user-level %APPDATA%\NuGet\NuGet.Config on some
  machines declares an EMPTY <packageSources> element, which suppresses the
  default nuget.org source. Every restore then fails with NU1100 ("unable to
  resolve <package> for <framework>") which looks like a TFM compatibility bug
  but is really "no package source configured". Declaring the source here makes
  the build independent of whatever the machine's global config says.

  If you are behind a mirror, replace the value below (e.g. a corporate feed or
  a local folder) - everything else in the build stays the same.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
