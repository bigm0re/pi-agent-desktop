# Normalize line endings in the repository, but keep Windows-native endings for
# shell scripts (cmd.exe requires CRLF for .cmd/.bat).
* text=auto

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary assets: never normalise, never diff.
*.ico  binary
*.png  binary
*.exe  binary
*.dll  binary
*.zip  binary

# Keep generated build output out of diffs even if it is ever force-added.
dist/**  -text -diff
